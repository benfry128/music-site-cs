@inherits LayoutComponentBase

<PageTitle>BenFryMusic Reviews</PageTitle>
<MudThemeProvider IsDarkMode="true" Theme="_darkTheme" />
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudToolBar
        Class="justify-center toolbar"
        Style="background-color: #272727"
    >
        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/">HOME</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/albums">ALBUM REVIEWS</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/db">DATABASE</MudButton>
    </MudToolBar>
    
    <MudMainContent>
        <MudStack
            AlignItems="AlignItems.Center"
        >
            @Body
        </MudStack>
    </MudMainContent>
</MudLayout>

@code{
    readonly MudTheme _darkTheme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = Colors.Orange.Default,
            Background = "#121212",
        }
    };
}