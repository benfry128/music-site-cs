@page "/db"
@using BenFryMusic.Entities
@using BenFryMusic.Services
@inject AlbumService AlbumService

<MudText Typo="Typo.h3">Albums Database</MudText>
<MudText Typo="Typo.body1">This is the full database of albums I've reviewed or plan to review in the future. Take a look!</MudText>

@if (_albums.Count == 0)
{
    <MudProgressCircular Indeterminate="true"></MudProgressCircular>
}
else
{
    <MudDataGrid
        @ref="MyDataGrid"
        Items="@_albums"
        Style="background-color:#181818;width:1200px"
        SortMode="SortMode.Single"
        Filterable="true"
        FilterMode="DataGridFilterMode.Simple"
        ShowColumnOptions="false"
        QuickFilter="@QuickFilter"
    >
        <ToolBarContent>
            <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true" AdornmentIcon="@Icons.Material.Filled.Search"></MudTextField>
        </ToolBarContent>
        <ColGroup>
            <col style="width: 25%;"/>
            <col style="width: 20%;"/>
            <col style="width: 10%;"/>
            <col style="width: 5%;"/>
            <col style="width: 10%;"/>
            <col style="width: 25%;"/>
            <col style="width: 5%;"/>
        </ColGroup>
        <Columns>
            <PropertyColumn Property="x => x.Title" Filterable="false" CellStyle="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 0px;"/>
            <PropertyColumn Property="x => x.Artist" Filterable="false" CellStyle="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 0px;"/>
            <PropertyColumn Property="x => x.DateReleased" Title="Released"/>
            <PropertyColumn Property="x => x.Rating" Comparer="@(new CompareNull { ThisDataGrid = MyDataGrid })" Sortable="false"/>
            <PropertyColumn Property="x => x.DateListened" Title="Listened" Comparer="@(new CompareNull { ThisDataGrid = MyDataGrid })"/>
            <PropertyColumn Property="x => x.FavoriteSong" Filterable="false" Title="Top Song" Comparer="@(new CompareNull { ThisDataGrid = MyDataGrid })" CellStyle="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 0px;"/>
            <PropertyColumn Property="x => x.Ranking" Comparer="@(new CompareNull { ThisDataGrid = MyDataGrid })"/>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="Album"></MudDataGridPager>
        </PagerContent>
    </MudDataGrid>
}

<MudButton Variant="Variant.Outlined" Color="Color.Primary">
    Review an Album
</MudButton>

@code {
    private MudDataGrid<Album> MyDataGrid;

    private List<Album> _albums = [];
    private string _searchString = "";

    private Func<Album, bool> QuickFilter => x => 
        string.IsNullOrWhiteSpace(_searchString) || 
        _searchString.ToLower().Split(" ").All(w => x.Title.ToLower().Contains(w) 
                                                    || x.Artist.ToLower().Contains(w) 
                                                    || (x.FavoriteSong?.ToLower().Contains(w) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(1);
        _albums = AlbumService.GetAllAlbums();
    }

    public class CompareNull : Comparer<object?>
    {
        public MudDataGrid<Album> ThisDataGrid;
        
        public override int Compare(object? x, object? y)
        {
            var desc = ThisDataGrid.SortDefinitions.Values.ToList()[0].Descending;
            if (x is null || x.ToString() == "")
            {
                if (y is null || y.ToString() == "")
                {
                    return 0;
                }
                return desc ? -1 : 1;
            }
            if (y is null || y.ToString() == "")
            {
                return desc ? 1 : -1;
            }
            if (x is IComparable xComparable && y is IComparable)
            {
                return xComparable.CompareTo(y);
            }
            return string.Compare(x.ToString(), y.ToString(), StringComparison.Ordinal);
        }
    }

}