@page "/db"
@using BenFryMusic.Entities
@using BenFryMusic.Services
@inject AlbumService albumService

<MudText Typo="Typo.h3">Albums Database</MudText>
<MudText Typo="Typo.body1">This is the full database of albums I've reviewed or plan to review in the future. Take a look!</MudText>
 
<MudDataGrid Items="@albums">
    <Columns>
        <PropertyColumn Property="x => x.Title" />
        <PropertyColumn Property="x => x.Artist" />
        <PropertyColumn Property="x => x.DateReleased" Title="Released"/>
        <PropertyColumn Property="x => x.Rating" />
        <PropertyColumn Property="x => x.DateListened" Title="Listened"/>
        <PropertyColumn Property="x => x.FavoriteSong" Title="Top Song"/>
        <PropertyColumn Property="x => x.Ranking" />
        <PropertyColumn Property="x => x.QueuePosition" Title="Queue"/>
    </Columns>
</MudDataGrid>

<MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@Append">
    Review an Album
</MudButton>

@code {

    private List<Album> albums = [];

    private void Append()
    {
        albums = albumService.GetAllAlbums();
    }

}